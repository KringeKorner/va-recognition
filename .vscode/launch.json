{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run CPM",
      "type": "debugpy",
      "request": "launch",
      "module": "cpm.central_processing_module",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "c:/Ryerson/Capstone/va-recognition/ESP32S3/esp32s3_idf_testbenches/esp-idf-prototype",
      "program": "c:/Ryerson/Capstone/va-recognition/ESP32S3/esp32s3_idf_testbenches/esp-idf-prototype/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}